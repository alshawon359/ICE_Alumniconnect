# Backend development env example
APP_ENV=development
DEBUG=true
PORT=5000
SECRET_KEY=change-me-in-local-dev
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Mail (dev)
MAIL_PROVIDER=brevo
SMTP_FROM_EMAIL=you@example.com
SMTP_FROM_NAME=AlumniConnect Admin
BREVO_EMAIL=you@example.com
BREVO_API_KEY=replace-with-brevo-api-key

# MySQL (local)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=alumniconnect
MYSQL_SSL_MODE=disable
AUTO_INIT_DB=true
