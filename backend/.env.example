# Production-ready local template for AlumniConnect backend

# App runtime
DEBUG=false
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://your-production-domain.example

# CORS
CORS_ORIGINS=https://your-frontend-domain.example

# Admin bootstrap
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-me-now

# Mail delivery
# Use Brevo as the primary provider in production.
MAIL_PROVIDER=brevo
SMTP_FROM_EMAIL=verified-sender@example.com
SMTP_FROM_NAME=AlumniConnect Admin
BREVO_EMAIL=verified-sender@example.com
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_TIMEOUT=20
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USE_TLS=true
MAIL_REPLY_TO=verified-sender@example.com
MAIL_UNSUBSCRIBE_EMAIL=verified-sender@example.com

# Optional routing controls
MAIL_FORCE_SMTP_DOMAINS=ru.ac.bd
MAIL_PLAIN_ONLY_DOMAINS=ru.ac.bd

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=alumniconnect
MYSQL_SSL_MODE=disable
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30

# Database bootstrap/migrations
AUTO_INIT_DB=false
DB_CONNECT_RETRIES=5
DB_RETRY_BASE_DELAY=0.6
DB_RETRY_MAX_DELAY=8.0