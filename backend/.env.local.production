# Local production simulation environment
# DO NOT USE REAL PRODUCTION CREDENTIALS HERE
APP_ENV=production
DEBUG=false
PORT=5000
SECRET_KEY=local-dev-secret-key-change-in-prod
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Admin (safe test credentials)
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=admin@1234

# Email (dummy Brevo)
MAIL_PROVIDER=brevo
SMTP_FROM_EMAIL=test@local.example.com
SMTP_FROM_NAME=AlumniConnect Local Test
BREVO_EMAIL=test@local.example.com
BREVO_API_KEY=dummy-key-local-only
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_TIMEOUT=20
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USE_TLS=true

# MySQL (Docker service)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=ac_user
MYSQL_PASSWORD=local-db-pass-change-in-prod
MYSQL_DB=alumniconnect
MYSQL_SSL_MODE=disable
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30

# Bootstrap
AUTO_INIT_DB=true
DB_CONNECT_RETRIES=5
DB_RETRY_BASE_DELAY=0.6
DB_RETRY_MAX_DELAY=8.0
