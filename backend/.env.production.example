# AlumniConnect - Production Environment Template
# 
# INSTRUCTIONS:
# 1. Copy this file to .env.production
# 2. Replace all placeholder values with real values
# 3. Keep this file SECURE (never commit with real values)
# 4. Recommended permissions: 600 (rw-------)

# ============= APPLICATION =============
APP_ENV=production
DEBUG=false
PORT=5000

# CRITICAL: Generate a random 32+ character key
# Command: head -c 32 /dev/urandom | base64
SECRET_KEY=CHANGE_THIS_TO_RANDOM_32_CHAR_KEY_12345678

# ============= DEPLOYMENT =============
# For csf.ru.ac.bd/iceaa deployment:
PUBLIC_BASE_URL=http://csf.ru.ac.bd/iceaa
CORS_ORIGINS=http://csf.ru.ac.bd

# ============= DATABASE (MYSQL) =============
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=alumniconnect_user
MYSQL_PASSWORD=CHANGE_THIS_PASSWORD
MYSQL_DB=alumniconnect
MYSQL_SSL_MODE=disable
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30

SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_MAX_OVERFLOW=20

# ============= EMAIL (BREVO) =============
MAIL_PROVIDER=brevo
BREVO_API_KEY=CHANGE_THIS_TO_REAL_BREVO_API_KEY
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_TIMEOUT=30
SMTP_FROM_EMAIL=noreply@csf.ru.ac.bd
SMTP_FROM_NAME=AlumniConnect ICE AAAA

# ============= UPLOADS & STORAGE =============
UPLOAD_FOLDER=/var/www/html/iceaa/ICE_AlumniConnect/backend/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============= GUNICORN =============
GUNICORN_BIND=127.0.0.1:5000
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_ACCESS_LOG=/var/log/alumniconnect/access.log
GUNICORN_ERROR_LOG=/var/log/alumniconnect/error.log
GUNICORN_LOG_LEVEL=info

# ============= LOGGING =============
LOG_LEVEL=INFO
LOG_FILE=/var/log/alumniconnect/app.log
LOG_ERROR_FILE=/var/log/alumniconnect/error.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ============= RATE LIMITING =============
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_STRATEGY=fixed-window

# ============= ADMIN CREDENTIALS =============
# IMPORTANT: Change these immediately after first login!
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=admin@1234

# ============= SESSION =============
SESSION_TIMEOUT=86400
SESSION_COOKIE_DOMAIN=

# Bootstrap/migrations
AUTO_INIT_DB=false
DB_CONNECT_RETRIES=5
DB_RETRY_BASE_DELAY=0.6
DB_RETRY_MAX_DELAY=8.0
