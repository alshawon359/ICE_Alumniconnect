# Backend production env example
APP_ENV=production
DEBUG=false
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret

# Public Base URL - Can be HTTP or HTTPS
# If not set, will be auto-detected from request headers
# Examples:
#   https://csf.ru.ac.bd/iceaa     (HTTPS with subpath)
#   http://csf.ru.ac.bd/iceaa      (HTTP with subpath)
#   https://example.com            (HTTPS root)
PUBLIC_BASE_URL=https://your-domain.com/iceaa

# CORS Origins - Can be empty (auto-detected from request origin)
# For reverse proxy scenarios, can leave empty or use wildcard
# Examples:
#   https://your-domain.com        (specific origin)
#   *                              (allow all - permissive)
#   (empty - permissive, detected from request)
CORS_ORIGINS=https://your-domain.com

# Admin bootstrap
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-me-now

# Mail (production)
MAIL_PROVIDER=brevo
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=AlumniConnect
BREVO_API_KEY=replace-with-brevo-api-key

# MySQL (production)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ac_user
MYSQL_PASSWORD=strong-password-here
MYSQL_DB=alumniconnect

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# MySQL SSL/Timeout (optional)
MYSQL_SSL_MODE=disable
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30

# Bootstrap/migrations
AUTO_INIT_DB=false
DB_CONNECT_RETRIES=5
DB_RETRY_BASE_DELAY=0.6
DB_RETRY_MAX_DELAY=8.0
